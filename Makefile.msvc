# Run in an x64 Visual Studio developer terminal: nmake /f Makefile.msvc test
!IFNDEF BUILD_DIR
BUILD_DIR=build-nmake
!ENDIF
!IFNDEF CMAKE_FLAGS
CMAKE_FLAGS=
!ENDIF
!IFNDEF PREFIX
PREFIX=C:\Tools\SerialUART
!ENDIF
all: configure
	cmake --build "$(BUILD_DIR)" --config Release
configure:
	cmake -S . -B "$(BUILD_DIR)" -G "NMake Makefiles" -DCMAKE_BUILD_TYPE=Release $(CMAKE_FLAGS)
test: all
	ctest --test-dir "$(BUILD_DIR)" -C Release --output-on-failure
install: all
	cmake --install "$(BUILD_DIR)" --config Release --prefix "$(PREFIX)"
clean:
	cmake --build "$(BUILD_DIR)" --target clean --config Release
