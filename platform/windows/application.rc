#include <winver.h>

#if defined(SUART_FULL_APP)
#define APP_NAME "SerialUART"
#define APP_DESCRIPTION "SerialUART interactive serial workspace"
#elif defined(SUART_LOOPBACK_APP)
#define APP_NAME "SerialLoopback"
#define APP_DESCRIPTION "SerialUART serial loopback test"
#else
#define APP_NAME "SendCommand"
#define APP_DESCRIPTION "SerialUART command-line sender"
#endif

#define STRINGIFY_RAW(value) #value
#define STRINGIFY(value) STRINGIFY_RAW(value)
#define VERSION_TEXT STRINGIFY(SUART_RESOURCE_MAJOR) "." STRINGIFY(SUART_RESOURCE_MINOR) "." STRINGIFY(SUART_RESOURCE_PATCH)
#define VERSION_NUMBER SUART_RESOURCE_MAJOR,SUART_RESOURCE_MINOR,SUART_RESOURCE_PATCH,0

101 ICON "serialuart.ico"

1 VERSIONINFO
FILEVERSION VERSION_NUMBER
PRODUCTVERSION VERSION_NUMBER
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "DRSDavidSoft"
            VALUE "FileDescription", APP_DESCRIPTION
            VALUE "FileVersion", VERSION_TEXT
            VALUE "InternalName", APP_NAME
            VALUE "OriginalFilename", APP_NAME ".exe"
            VALUE "ProductName", "SerialUART"
            VALUE "ProductVersion", VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
